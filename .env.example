APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The Next.js client origin. Used to build the CORS allow list in config/cors.php.
# Local development default when unset: http://localhost:3000 and http://127.0.0.1:3000.
# Production example: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Extra fixed origins, comma separated (staging clients, a second frontend, ...).
CORS_ALLOWED_ORIGINS=

# Regular expressions for origins that cannot be enumerated ahead of time, such
# as Vercel per-deployment preview URLs. Comma separated.
# Example: /^https:\/\/your-app-[a-z0-9-]+\.vercel\.app$/
CORS_ALLOWED_ORIGIN_PATTERNS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Booking rules - see config/booking.php
BOOKING_MAX_GUESTS=8
BOOKING_FREE_GUEST_THRESHOLD=6
BOOKING_EXTRA_GUEST_FEE=500
BOOKING_MIN_NIGHTS=1
BOOKING_MAX_NIGHTS=30
BOOKING_MAX_ADVANCE_DAYS=365
BOOKING_DEPOSIT_RATIO=0.5

# Payment proofs are private. "local" keeps them outside the web root; they are
# only ever served through GET /api/v1/bookings/{booking}/proof.
BOOKING_PROOF_DISK=local
BOOKING_PROOF_MAX_KB=5120

# Only needed if you ever enable Sanctum's cookie/SPA mode. The Vercel + Hostinger
# split does not share a registrable domain, so the API uses bearer tokens instead.
# SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=
