# The Laravel backend ORIGIN - not the /api/v1 prefix.
# The client derives /sanctum/csrf-cookie, /login, /logout, /api/auth/me and
# /api/v1/* from this single value, so no deployment URL is repeated in components.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example (must be HTTPS for the session cookie to be accepted):
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
