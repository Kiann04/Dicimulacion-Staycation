# Dicimulacion Staycation - Frontend Environment Variables
# Copy to .env.local for local development overrides.

# Application
NEXT_PUBLIC_APP_NAME="Dicimulacion Staycation"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Laravel REST API Base URL (default is http://localhost:8000 if unset)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: Enable offline mock dataset for testing/demos (set to "true" to bypass API)
# NEXT_PUBLIC_USE_MOCK_API=false
